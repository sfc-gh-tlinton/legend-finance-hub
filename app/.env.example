# Copy to .env.local (install.sh generates this for you)
SNOWFLAKE_CONNECTION_NAME=default
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN
LEGEND_DB=LEGENDBIO
# Set to 1 to call the agent via SQL (DATA_AGENT_RUN) instead of the REST API.
# Used automatically when the connection has no PAT/OAuth token (e.g. externalbrowser SSO).
# LEGEND_AGENT_VIA_SQL=1
